# ═══════════════════════════════════════════════════════════════
# AutoBiz Engine — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Salin file ini ke .env dan isi nilai-nilai yang sesuai.
# JANGAN commit file .env ke version control!
# ═══════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────
APP_NAME=AutoBiz Engine
DEBUG=false
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/autobiz_engine
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=1800

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# ─── Anthropic (optional) ────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Email ───────────────────────────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=

# ─── Stripe (optional) ──────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Supabase (optional) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ─── AWS (optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=autobiz-engine-storage

# ─── Monitoring ──────────────────────────────────────────────
SENTRY_DSN=
DISCORD_WEBHOOK_URL=

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_AUTO_APPROVE=false
MAX_BUDGET_PER_BUSINESS=5000.0

# ─── Security (auto-generated by rotate_secrets.py) ─────────
JWT_SECRET=
ENCRYPTION_KEY=
WEBHOOOK_SIGNING_SECRET=