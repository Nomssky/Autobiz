# AutoBiz Engine — Environment Configuration
# Copy to .env and fill in your values.

APP_NAME=AutoBiz Engine
DEBUG=false
# SECRET_KEY is auto-generated by './autobiz'.
# To set manually: SECRET_KEY=$(openssl rand -hex 32)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Requires PostgreSQL via Docker:
#   docker compose up -d db
DATABASE_URL=postgresql+psycopg2://autobiz:secret@localhost:5432/autobiz_engine
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://localhost:6379

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=1800

# --- LLM Provider ---
# Uses OpenAI-compatible API. Set LLM_BASE_URL for custom endpoints.
# OpenRouter example:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4-turbo
LLM_BASE_URL=
LLM_TEMPERATURE=0.7

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding Provider ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=

# --- Notifications (optional, configure via TUI) ---
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
SENDGRID_API_KEY=

# --- Monitoring ---
SENTRY_DSN=

# --- Features ---
ENABLE_AUTO_APPROVE=false
MAX_BUDGET_PER_BUSINESS=5000.0
