#!/usr/bin/env bash
# ─── AutoBiz — One command to build AI-powered businesses ───
# Usage: ./autobiz          → Launch TUI (backend auto-starts if needed)
#        ./autobiz --web    → Open web dashboard
#        ./autobiz --help   → Show help
set -e

cd "$(dirname "$0")"
ROOT="$PWD"
BACKEND_DIR="$ROOT/backend"
TUI_BIN="$ROOT/frontend/tui/autobiz-tui"
CLI_BIN="$ROOT/frontend/cli/bin/autobiz.js"

# ─── Colors ──────────────────────────────────────────────
BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
DIM='\033[2m'
NC='\033[0m' # No Color

info()  { echo -e "  ${DIM}ℹ${NC} $1"; }
ok()    { echo -e "  ${GREEN}✓${NC} $1"; }
warn()  { echo -e "  ${YELLOW}⚠${NC} $1"; }

# ─── Help ────────────────────────────────────────────────
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo -e "${BOLD}
  ╔══════════════════════════════════════╗
  ║          AutoBiz Engine              ║
  ╚══════════════════════════════════════╝${NC}"
  echo ""
  echo -e "  ${BOLD}Usage:${NC}"
  echo -e "    ${CYAN}./autobiz${NC}              Launch Terminal UI"
  echo -e "    ${CYAN}./autobiz --web${NC}        Open web dashboard"
  echo -e "    ${CYAN}./autobiz --help${NC}       Show this help"
  echo ""
  echo -e "  ${BOLD}Quick start:${NC}"
  echo -e "    1. ${DIM}Install Ollama:${NC} ${CYAN}curl -fsSL https://ollama.com/install.sh | sh${NC}"
  echo -e "    2. ${DIM}Pull a model:${NC}  ${CYAN}ollama pull llama3${NC}"
  echo -e "    3. ${DIM}Run AutoBiz:${NC}   ${CYAN}./autobiz${NC}"
  echo ""
  exit 0
fi

# ─── Check prerequisites ─────────────────────────────────
has_command() { command -v "$1" >/dev/null 2>&1; }

if ! has_command python3 && ! has_command python; then
  echo -e "  ${RED}✗${NC} Python 3.9+ is required"
  exit 1
fi
PYTHON=$(has_command python3 && echo "python3" || echo "python")

# ─── Auto-start backend ──────────────────────────────────
start_backend() {
  info "Starting backend..."

  # Create virtualenv if needed
  if [ ! -d "$BACKEND_DIR/venv" ]; then
    info "Creating Python virtualenv..."
    "$PYTHON" -m venv "$BACKEND_DIR/venv"
    ok "Virtualenv created"
  fi

  # Install dependencies if needed
  if [ ! -f "$BACKEND_DIR/venv/.installed" ]; then
    info "Installing dependencies..."
    "$BACKEND_DIR/venv/bin/pip" install -q -r "$BACKEND_DIR/requirements.txt"
    touch "$BACKEND_DIR/venv/.installed"
    ok "Dependencies installed"
  fi

  # Copy .env if needed
  if [ ! -f "$BACKEND_DIR/../.env" ]; then
    cp "$BACKEND_DIR/../.env.example" "$BACKEND_DIR/../.env"
    warn "Please edit .env and set your SECRET_KEY"
  fi

  # Start uvicorn (run from backend/ so 'app' module is importable)
  cd "$BACKEND_DIR"
  PYTHONPATH="$BACKEND_DIR" \
  DEBUG=true DATABASE_URL=sqlite:///./autobiz_dev.db \
    "$BACKEND_DIR/venv/bin/uvicorn" app.main:app \
    --host 0.0.0.0 --port 8000 --log-level warning &
  cd "$ROOT"
  BACKEND_PID=$!

  # Wait for backend to be ready
  echo -n "  Waiting for backend"
  for i in $(seq 1 30); do
    if curl -sf http://localhost:8000/health > /dev/null 2>&1; then
      echo ""
      ok "Backend ready"
      return 0
    fi
    echo -n "."
    sleep 1
  done
  echo ""
  warn "Backend may not be ready yet — check http://localhost:8000/health"
}

# ─── Cleanup on exit ─────────────────────────────────────
cleanup() {
  if [ -n "$BACKEND_PID" ]; then
    kill "$BACKEND_PID" 2>/dev/null || true
    ok "Backend stopped"
  fi
}
trap cleanup EXIT

# ─── Web mode ────────────────────────────────────────────
if [[ "$1" == "--web" || "$1" == "-w" ]]; then
  if ! curl -sf http://localhost:8000/health > /dev/null 2>&1; then
    start_backend
  fi
  echo ""
  echo -e "  ${GREEN}🌐  Web Dashboard:${NC} ${BOLD}http://localhost:3000${NC}"
  echo -e "  ${DIM}📡  API: http://localhost:8000${NC}"
  echo ""
  exit 0
fi

# ─── TUI mode (default) ──────────────────────────────────
echo ""
echo -e "  ${BOLD}AutoBiz Engine${NC} ${DIM}— build AI-powered businesses${NC}"
echo ""

# Start backend if not running
if ! curl -sf http://localhost:8000/health > /dev/null 2>&1; then
  start_backend
fi

# Check if TUI binary exists
if [ -f "$TUI_BIN" ]; then
  "$TUI_BIN"
else
  warn "TUI not found, falling back to CLI..."
  if [ -f "$CLI_BIN" ]; then
    node "$CLI_BIN"
  else
    echo -e "  ${YELLOW}⚠${NC} No TUI or CLI found. Backend is running at http://localhost:8000"
    echo -e "  ${DIM}  Start the frontend dashboard:${NC} cd frontend/dashboard && npm run dev"
  fi
fi
