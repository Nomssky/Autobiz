#!/usr/bin/env bash
# ─── AutoBiz — Development shortcut ───
# Usage: ./autobiz
set -e

ROOT="$(cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="$ROOT/backend"
VENV_DIR="$BACKEND_DIR/venv"
PYTHON=$(command -v python3 || command -v python)

echo ""
echo "  AutoBiz Engine — development mode"
echo ""

# ─── Start Docker ─────────────────────────────────
echo "  ℹ Starting PostgreSQL & Redis..."
cd "$ROOT"
docker compose up -d db redis 2>/dev/null || echo "  ⚠ Docker not running — continuing"

# ─── Setup venv ───────────────────────────────────
if [ ! -d "$VENV_DIR" ]; then
  echo "  ℹ Creating virtualenv..."
  "$PYTHON" -m venv "$VENV_DIR"
fi

if [ ! -f "$VENV_DIR/.installed" ]; then
  echo "  ℹ Installing backend dependencies..."
  "$VENV_DIR/bin/pip" install -q -r "$BACKEND_DIR/requirements.txt"
  echo "  ℹ Installing TUI dependencies..."
  "$VENV_DIR/bin/pip" install -q -r "$ROOT/tui/requirements.txt" 2>/dev/null || true
  touch "$VENV_DIR/.installed"
fi

# ─── Generate .env ────────────────────────────────
if [ ! -f "$ROOT/.env" ]; then
  cp "$ROOT/.env.example" "$ROOT/.env"
  echo "  ✓ .env created"
fi

CURRENT_SECRET=$(grep "^SECRET_KEY=" "$ROOT/.env" 2>/dev/null | cut -d= -f2-)
if [ -z "$CURRENT_SECRET" ]; then
  KEY=$(openssl rand -hex 32 2>/dev/null || "$PYTHON" -c "import secrets; print(secrets.token_hex(32))")
  if grep -q "^SECRET_KEY=" "$ROOT/.env" 2>/dev/null; then
    sed -i "s/^SECRET_KEY=.*/SECRET_KEY=$KEY/" "$ROOT/.env"
  else
    echo "SECRET_KEY=$KEY" >> "$ROOT/.env"
  fi
  echo "  ✓ SECRET_KEY auto-generated"
fi

# ─── Start backend ────────────────────────────────
echo "  ℹ Starting backend..."
cd "$BACKEND_DIR"
PYTHONPATH="$PWD" "$VENV_DIR/bin/uvicorn" app.main:app \
  --host 0.0.0.0 --port 8000 --reload &
BACKEND_PID=$!
cd "$ROOT"

echo -n "  Waiting for backend"
for i in $(seq 1 30); do
  if curl -sf http://localhost:8000/health > /dev/null 2>&1; then
    echo ""
    echo "  ✓ Backend ready → http://localhost:8000/ui/dashboard"
    break
  fi
  echo -n "."
  sleep 1
done

# ─── Detect LLVM ---────────────────────────────────
echo ""
echo "  ℹ Detecting Ollama..."
OLLAMA_MODELS=$(curl -sf http://localhost:11434/api/tags 2>/dev/null | python3 -c "
import sys,json
try: d=json.load(sys.stdin); print(' '.join(m['name'] for m in d.get('models',[])) or 'none')
except: print('not_running')
" 2>/dev/null || echo "not_running")

if [ "$OLLAMA_MODELS" = "not_running" ]; then
  echo "  ⚠ Ollama tidak terdeteksi. Install: https://ollama.com"
  echo "  ⚠ Atau set LLM_PROVIDER=openai + LLM_API_KEY di .env"
else
  echo "  ✓ Ollama models: $OLLAMA_MODELS"
fi

# ─── Cleanup on exit ──────────────────────────────
cleanup() {
  echo ""
  echo "  ℹ Stopping backend..."
  kill $BACKEND_PID 2>/dev/null || true
  wait $BACKEND_PID 2>/dev/null || true
  echo "  ✓ Done"
}
trap cleanup EXIT INT TERM

# ─── Launch TUI ───────────────────────────────────
echo ""
  echo "  🚀 Launching TUI..."
cd "$ROOT"
"$VENV_DIR/bin/python" tui/main.py 2>&1 || echo "  ⚠ TUI error — buka http://localhost:8000/ui/dashboard di browser"
